# ==============================================================================
# ORATOR.AI SERVER-SIDE INFERENCE CONFIGURATION
# (Keep all provider secrets server-side; NEVER prefix with VITE_)
# ==============================================================================

# Cheaper Inference (Preferred initial multi-provider hosted endpoint)
CHEAPER_INFERENCE_ENABLED=true
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com/v1
CHEAPER_INFERENCE_API_KEY=
CHEAPER_INFERENCE_ALLOWED_MODELS=google/gemini-1.5-flash,openai/gpt-4o-mini,anthropic/claude-3.5-sonnet,meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat
CHEAPER_INFERENCE_EXPLORATION_MODELS=google/gemini-1.5-flash,openai/gpt-4o-mini,meta-llama/llama-3.3-70b-instruct
CHEAPER_INFERENCE_BUILD_MODELS=anthropic/claude-3.5-sonnet,openai/gpt-4o,deepseek/deepseek-chat
CHEAPER_INFERENCE_VERIFICATION_MODELS=openai/gpt-4o,anthropic/claude-3.5-sonnet
CHEAPER_INFERENCE_REQUEST_TIMEOUT_MS=45000
CHEAPER_INFERENCE_MAX_RETRIES=2
CHEAPER_INFERENCE_MAX_COST_PER_REQUEST=0.25

# OpenRouter (Fallback multi-provider gateway)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct Model Providers (Optional direct fallbacks)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Hugging Face Inference (Optional open-weight fallback)
HUGGINGFACE_API_KEY=

# OmniRoute (Optional future self-hosted gateway — disabled by default)
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://localhost:8000/v1
OMNIROUTE_API_KEY=
